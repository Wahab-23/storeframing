// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
  STAFF
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  CLOSED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductVisibility {
  VISIBLE
  HIDDEN
}

enum ProductType {
  SIMPLE
  VARIABLE
  DIGITAL
  VIRTUAL
  SERVICE
  BUNDLE
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
  ARCHIVED
}

enum ListingCondition {
  NEW
  USED
  REFURBISHED
  OPEN_BOX
}

enum AttributeType {
  TEXT
  TEXTAREA
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  SELECT
  MULTI_SELECT
  COLOR
}

enum AttributeScope {
  PRODUCT
  LISTING
  VARIANT
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  COMPLETED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum SellerOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  COMPLETED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum OrderStatusHistorySource {
  SYSTEM
  CUSTOMER
  SELLER
  ADMIN
  PAYMENT
  SHIPPING
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  WALLET
  ONLINE
  OTHER
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum InventoryMovementType {
  INBOUND
  SALE
  RETURN
  REFUND
  ADJUSTMENT
  DAMAGE
  RESERVED
  RELEASED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  INSPECTING
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  AVAILABLE
  PAID
  REVERSED
}

enum WalletTransactionType {
  SALE
  COMMISSION
  REFUND
  WITHDRAWAL
  ADJUSTMENT
  BONUS
  PENALTY
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  COMPLETED
  FAILED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum NotificationType {
  ORDER
  PAYMENT
  SHIPPING
  REVIEW
  MESSAGE
  SELLER
  SYSTEM
  PROMOTION
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CouponScope {
  GLOBAL
  PRODUCT
  CATEGORY
  SELLER
}

enum AddressType {
  BILLING
  SHIPPING
  BUSINESS
  OTHER
}

enum DocumentType {
  IDENTITY
  BUSINESS_LICENSE
  TAX_DOCUMENT
  BANK_DOCUMENT
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  SUSPEND
  RESTORE
}

enum SellerEarningStatus {
  PENDING
  AVAILABLE
  PAID
  REVERSED
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ============================================================
// USERS
// ============================================================

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  phone           String?
  avatarUrl       String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roleAssignments UserRoleAssignment[]

  seller Seller?

  addresses Address[]

  cart     Cart?
  wishlist Wishlist?

  orders Order[]

  productReviews ProductReview[]
  sellerReviews  SellerReview[]

  conversations ConversationParticipant[]
  messages      Message[]

  notifications Notification[]

  couponUsages CouponUsage[]

  returnRequests ReturnRequest[]

  auditLogs AuditLog[]

  createdProducts Product[] @relation("ProductCreatedBy")

  @@index([status])
  @@index([createdAt])
}

// ============================================================
// RBAC
// ============================================================

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRoleAssignment[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  roles RolePermission[]
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ============================================================
// ADDRESSES
// ============================================================

model Address {
  id     String      @id @default(cuid())
  userId String
  type   AddressType @default(OTHER)

  firstName    String
  lastName     String
  company      String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  countryCode  String
  phone        String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
}

// ============================================================
// SELLERS
// ============================================================

model Seller {
  id     String @id @default(cuid())
  userId String @unique

  shopName      String
  slug          String  @unique
  description   String? @db.Text
  logoUrl       String?
  bannerUrl     String?
  businessEmail String?
  businessPhone String?

  status             SellerStatus       @default(PENDING)
  verificationStatus VerificationStatus @default(PENDING)

  sellerGroupId String?

  commissionRate Decimal? @db.Decimal(5, 2)

  totalSales    Decimal @default(0) @db.Decimal(18, 2)
  totalOrders   Int     @default(0)
  averageRating Decimal @default(0) @db.Decimal(3, 2)
  reviewCount   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerGroup SellerGroup? @relation(fields: [sellerGroupId], references: [id], onDelete: SetNull)

  seo SellerSeo?

  documents      SellerDocument[]
  payoutAccounts SellerPayoutAccount[]

  products SellerListing[]

  sellerOrders SellerOrder[]

  reviews SellerReview[]

  wallet SellerWallet?

  walletTransactions SellerWalletTransaction[]

  earnings SellerEarning[]

  withdrawals Withdrawal[]

  commissionRules CommissionRule[]

  coupons Coupon[]

  vacation SellerVacation?
  policies SellerPolicy?

  conversations Conversation[]

  @@index([status])
  @@index([verificationStatus])
  @@index([sellerGroupId])
}

model SellerGroup {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellers     Seller[]
  permissions SellerGroupPermission[]
}

model SellerGroupPermission {
  id            String @id @default(cuid())
  sellerGroupId String
  permission    String

  sellerGroup SellerGroup @relation(fields: [sellerGroupId], references: [id], onDelete: Cascade)

  @@unique([sellerGroupId, permission])
}

model SellerDocument {
  id       String @id @default(cuid())
  sellerId String

  type    DocumentType
  fileUrl String

  status DocumentStatus @default(PENDING)
  notes  String?        @db.Text

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
}

model SellerPayoutAccount {
  id       String @id @default(cuid())
  sellerId String

  provider      String
  accountName   String
  accountNumber String
  bankName      String?
  branchName    String?

  isDefault  Boolean @default(false)
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model SellerVacation {
  id       String @id @default(cuid())
  sellerId String @unique

  enabled   Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?
  message   String?

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model SellerPolicy {
  id       String @id @default(cuid())
  sellerId String @unique

  shippingPolicy String? @db.Text
  returnPolicy   String? @db.Text
  refundPolicy   String? @db.Text

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

// ============================================================
// SEO
// ============================================================

model SeoMetadata {
  id String @id @default(cuid())

  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.Text
  metaKeywords    String? @db.Text

  canonicalUrl String?

  ogTitle       String?
  ogDescription String? @db.Text
  ogImageUrl    String?

  twitterTitle       String?
  twitterDescription String? @db.Text
  twitterImageUrl    String?

  robots String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product?
  category Category?
  brand    Brand?
  seller   SellerSeo?
  page     CmsPage?
}

// ============================================================
// BRANDS
// ============================================================

model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  logoUrl     String?
  isActive    Boolean @default(true)

  seoId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seo      SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([isActive])
}

// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id       String  @id @default(cuid())
  parentId String?

  name        String
  slug        String  @unique
  description String? @db.Text
  imageUrl    String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  seoId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  seo      SeoMetadata?      @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products ProductCategory[]

  attributes CategoryAttribute[]

  coupons CouponCategory[]

  commissionRules CommissionRule[]

  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
}

// ============================================================
// CATEGORY ATTRIBUTES
// ============================================================

model CategoryAttribute {
  id          String @id @default(cuid())
  categoryId  String
  attributeId String

  isRequired   Boolean @default(false)
  isFilterable Boolean @default(false)
  isVariant    Boolean @default(false)
  sortOrder    Int     @default(0)

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@index([attributeId])
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id String @id @default(cuid())

  brandId String?
  seoId   String? @unique

  createdById String?

  name             String
  slug             String  @unique
  description      String? @db.Text
  shortDescription String? @db.Text

  productType ProductType       @default(SIMPLE)
  status      ProductStatus     @default(DRAFT)
  visibility  ProductVisibility @default(VISIBLE)

  modelNumber     String?
  manufacturer    String?
  countryOfOrigin String?

  weight Decimal? @db.Decimal(12, 4)
  length Decimal? @db.Decimal(12, 4)
  width  Decimal? @db.Decimal(12, 4)
  height Decimal? @db.Decimal(12, 4)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  brand     Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  seo       SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  categories ProductCategory[]

  images ProductImage[]

  variants ProductVariant[]

  attributes ProductAttributeValue[]

  listings SellerListing[]

  reviews ProductReview[]

  wishlistItems WishlistItem[]

  cartItems CartItem[]

  orderItems OrderItem[]

  couponProducts CouponProduct[]

  @@index([brandId])
  @@index([status])
  @@index([productType])
  @@index([createdAt])
}

// ============================================================
// PRODUCT IMAGES
// ============================================================

model ProductImage {
  id        String @id @default(cuid())
  productId String

  url     String
  altText String?

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
}

// ============================================================
// PRODUCT CATEGORIES
// ============================================================

model ProductCategory {
  id         String @id @default(cuid())
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
}

// ============================================================
// ATTRIBUTES
// ============================================================

model Attribute {
  id    String         @id @default(cuid())
  name  String
  code  String         @unique
  type  AttributeType
  scope AttributeScope

  isRequired   Boolean @default(false)
  isFilterable Boolean @default(false)
  isSearchable Boolean @default(false)
  isVariant    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values AttributeValue[]

  categories CategoryAttribute[]

  productValues ProductAttributeValue[]

  listingValues ListingAttributeValue[]

  variantValues VariantAttributeValue[]
}

model AttributeValue {
  id          String @id @default(cuid())
  attributeId String

  value String
  label String

  sortOrder Int @default(0)

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  productValues ProductAttributeValue[]

  listingValues ListingAttributeValue[]

  variantValues VariantAttributeValue[]

  @@index([attributeId])
}

// ============================================================
// PRODUCT ATTRIBUTES
// ============================================================

model ProductAttributeValue {
  id          String @id @default(cuid())
  productId   String
  attributeId String

  attributeValueId String?

  textValue    String?   @db.Text
  integerValue Int?
  decimalValue Decimal?  @db.Decimal(18, 6)
  booleanValue Boolean?
  dateValue    DateTime?
  jsonValue    Json?

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute      Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([attributeId])
  @@index([attributeValueId])
}

// ============================================================
// PRODUCT VARIANTS
// ============================================================

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  name String
  sku  String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributes VariantAttributeValue[]

  listings SellerListingVariant[]

  cartItems CartItem[]

  orderItems OrderItem[]

  @@index([productId])
}

model VariantAttributeValue {
  id        String @id @default(cuid())
  variantId String

  attributeId      String
  attributeValueId String?

  textValue    String?   @db.Text
  integerValue Int?
  decimalValue Decimal?  @db.Decimal(18, 6)
  booleanValue Boolean?
  dateValue    DateTime?
  jsonValue    Json?

  variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute      Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([attributeId])
}

// ============================================================
// SELLER LISTINGS
// ============================================================
//
// A Product is the catalog item.
// A SellerListing is the seller's offer for that product.
//

model SellerListing {
  id        String @id @default(cuid())
  sellerId  String
  productId String

  sellerSku String?

  price          Decimal  @db.Decimal(18, 2)
  compareAtPrice Decimal? @db.Decimal(18, 2)
  costPrice      Decimal? @db.Decimal(18, 2)

  condition ListingCondition @default(NEW)

  warrantyTitle       String?
  warrantyDescription String? @db.Text

  description String? @db.Text

  status ListingStatus @default(PENDING_REVIEW)

  rejectionReason String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  seller  Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributes ListingAttributeValue[]

  variants SellerListingVariant[]

  inventory Inventory?

  cartItems CartItem[]

  orderItems OrderItem[]

  wishlistItems WishlistItem[]

  @@unique([sellerId, productId])
  @@index([sellerId])
  @@index([productId])
  @@index([status])
  @@index([sellerId, status])
}

model SellerListingVariant {
  id        String @id @default(cuid())
  listingId String
  variantId String

  price          Decimal  @db.Decimal(18, 2)
  compareAtPrice Decimal? @db.Decimal(18, 2)
  costPrice      Decimal? @db.Decimal(18, 2)

  listing SellerListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  inventory Inventory?

  cartItems CartItem[]

  orderItems OrderItem[]

  @@unique([listingId, variantId])
  @@index([variantId])
}

model ListingAttributeValue {
  id        String @id @default(cuid())
  listingId String

  attributeId      String
  attributeValueId String?

  textValue    String?   @db.Text
  integerValue Int?
  decimalValue Decimal?  @db.Decimal(18, 6)
  booleanValue Boolean?
  dateValue    DateTime?
  jsonValue    Json?

  listing        SellerListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  attribute      Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([attributeId])
}

// ============================================================
// INVENTORY
// ============================================================

model Inventory {
  id String @id @default(cuid())

  listingId        String?
  listingVariantId String?

  quantity         Int @default(0)
  reservedQuantity Int @default(0)

  lowStockThreshold Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing        SellerListing?        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingVariant SellerListingVariant? @relation(fields: [listingVariantId], references: [id], onDelete: Cascade)

  movements InventoryMovement[]

  @@unique([listingId])
  @@unique([listingVariantId])
  @@index([quantity])
}

model InventoryMovement {
  id          String @id @default(cuid())
  inventoryId String

  type     InventoryMovementType
  quantity Int

  referenceType String?
  referenceId   String?

  note String? @db.Text

  createdAt DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

// ============================================================
// CART
// ============================================================

model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  status CartStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]
}

model CartItem {
  id     String @id @default(cuid())
  cartId String

  productId String
  listingId String

  variantId        String?
  listingVariantId String?

  quantity Int

  unitPrice Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  listing SellerListing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  listingVariant SellerListingVariant? @relation(fields: [listingVariantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([listingId])
  @@index([productId])
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id     String @id @default(cuid())
  userId String

  orderNumber String @unique

  status OrderStatus @default(PENDING)

  subtotal       Decimal @db.Decimal(18, 2)
  shippingAmount Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal @db.Decimal(18, 2)

  currency String @default("PKR")

  billingAddress  Json
  shippingAddress Json

  customerNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  items OrderItem[]

  sellerOrders SellerOrder[]

  payments Payment[]

  shipments Shipment[]

  statusHistory OrderStatusHistory[]

  returnRequests ReturnRequest[]

  sellerReviews SellerReview[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// ============================================================
// SELLER ORDERS
// ============================================================

model SellerOrder {
  id       String @id @default(cuid())
  orderId  String
  sellerId String

  sellerOrderNumber String @unique

  status SellerOrderStatus @default(PENDING)

  subtotal       Decimal @db.Decimal(18, 2)
  shippingAmount Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @db.Decimal(18, 2)

  commissionAmount Decimal @default(0) @db.Decimal(18, 2)
  sellerEarning    Decimal @default(0) @db.Decimal(18, 2)

  totalAmount Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  items OrderItem[]

  shipments Shipment[]

  earnings SellerEarning[]

  statusHistory SellerOrderStatusHistory[]

  @@index([orderId])
  @@index([sellerId])
  @@index([status])
  @@index([sellerId, createdAt])
}

// ============================================================
// ORDER ITEMS
// ============================================================

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  sellerOrderId String

  productId String
  listingId String

  variantId        String?
  listingVariantId String?

  productName String
  sku         String?

  quantity Int

  unitPrice      Decimal @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal @db.Decimal(18, 2)

  // Immutable historical copy of the item at purchase time.
  productSnapshot Json

  createdAt DateTime @default(now())

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  listing SellerListing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  listingVariant SellerListingVariant? @relation(fields: [listingVariantId], references: [id], onDelete: SetNull)

  shipmentItems ShipmentItem[]

  returnItems ReturnItem[]

  productReviews ProductReview[]

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([productId])
  @@index([listingId])
}

// ============================================================
// ORDER STATUS HISTORY
// ============================================================

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String

  fromStatus OrderStatus?
  toStatus   OrderStatus

  source OrderStatusHistorySource

  note String? @db.Text

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model SellerOrderStatusHistory {
  id            String @id @default(cuid())
  sellerOrderId String

  fromStatus SellerOrderStatus?
  toStatus   SellerOrderStatus

  source OrderStatusHistorySource

  note String? @db.Text

  createdAt DateTime @default(now())

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  @@index([sellerOrderId])
  @@index([createdAt])
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id      String @id @default(cuid())
  orderId String

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("PKR")

  provider      String?
  transactionId String?

  metadata Json?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
}

// ============================================================
// SHIPMENTS
// ============================================================

model Shipment {
  id            String  @id @default(cuid())
  orderId       String
  sellerOrderId String?

  trackingNumber String?
  carrier        String?

  status ShipmentStatus @default(PENDING)

  shippingAmount Decimal @default(0) @db.Decimal(18, 2)

  shippedAt   DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)

  items ShipmentItem[]

  trackingEvents TrackingEvent[]

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([trackingNumber])
  @@index([status])
}

model ShipmentItem {
  id          String @id @default(cuid())
  shipmentId  String
  orderItemId String

  quantity Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
}

model TrackingEvent {
  id         String @id @default(cuid())
  shipmentId String

  status      String
  description String?
  location    String?

  createdAt DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// ============================================================
// COMMISSIONS
// ============================================================

model CommissionRule {
  id String @id @default(cuid())

  sellerId   String?
  categoryId String?

  percentage  Decimal? @db.Decimal(5, 2)
  fixedAmount Decimal? @db.Decimal(18, 2)

  priority Int     @default(0)
  isActive Boolean @default(true)

  seller   Seller?   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([categoryId])
  @@index([isActive])
}

// ============================================================
// SELLER EARNINGS
// ============================================================

model SellerEarning {
  id            String @id @default(cuid())
  sellerId      String
  sellerOrderId String

  grossAmount      Decimal @db.Decimal(18, 2)
  commissionAmount Decimal @db.Decimal(18, 2)
  refundAmount     Decimal @default(0) @db.Decimal(18, 2)
  netAmount        Decimal @db.Decimal(18, 2)

  status SellerEarningStatus @default(PENDING)

  availableAt DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller      Seller      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)

  @@index([sellerId])
  @@index([sellerOrderId])
  @@index([status])
}

// ============================================================
// SELLER WALLET
// ============================================================

model SellerWallet {
  id       String @id @default(cuid())
  sellerId String @unique

  balance             Decimal @default(0) @db.Decimal(18, 2)
  pendingBalance      Decimal @default(0) @db.Decimal(18, 2)
  withdrawableBalance Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  transactions SellerWalletTransaction[]
}

model SellerWalletTransaction {
  id       String @id @default(cuid())
  sellerId String

  type   WalletTransactionType
  amount Decimal               @db.Decimal(18, 2)

  balanceAfter Decimal @db.Decimal(18, 2)

  referenceType String?
  referenceId   String?

  description String? @db.Text

  createdAt DateTime @default(now())

  seller         Seller        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerWallet   SellerWallet? @relation(fields: [sellerWalletId], references: [id])
  sellerWalletId String?

  @@index([sellerId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model Withdrawal {
  id       String @id @default(cuid())
  sellerId String

  amount Decimal @db.Decimal(18, 2)

  status WithdrawalStatus @default(PENDING)

  payoutAccountSnapshot Json

  transactionReference String?
  adminNotes           String? @db.Text

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId])
  @@index([status])
}

// ============================================================
// PRODUCT REVIEWS
// ============================================================

model ProductReview {
  id        String @id @default(cuid())
  productId String
  userId    String

  orderItemId String?

  rating  Int
  title   String?
  content String? @db.Text

  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([productId, status])
}

// ============================================================
// SELLER REVIEWS
// ============================================================

model SellerReview {
  id       String @id @default(cuid())
  sellerId String
  userId   String

  orderId String?

  rating  Int
  title   String?
  content String? @db.Text

  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@index([userId])
  @@index([status])
  @@index([sellerId, status])
}

// ============================================================
// WISHLIST
// ============================================================

model Wishlist {
  id     String @id @default(cuid())
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]
}

model WishlistItem {
  id         String @id @default(cuid())
  wishlistId String

  productId String
  listingId String?

  createdAt DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  listing SellerListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId, listingId])
  @@index([productId])
}

// ============================================================
// COUPONS
// ============================================================

model Coupon {
  id String @id @default(cuid())

  sellerId String?

  code        String  @unique
  description String?

  status CouponStatus @default(ACTIVE)
  scope  CouponScope

  discountType  DiscountType
  discountValue Decimal      @db.Decimal(18, 2)

  minimumOrderAmount    Decimal? @db.Decimal(18, 2)
  maximumDiscountAmount Decimal? @db.Decimal(18, 2)

  usageLimit   Int?
  usagePerUser Int?
  usedCount    Int  @default(0)

  startsAt  DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller Seller? @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  products   CouponProduct[]
  categories CouponCategory[]
  usages     CouponUsage[]

  @@index([sellerId])
  @@index([status])
  @@index([expiresAt])
}

model CouponProduct {
  id        String @id @default(cuid())
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
}

model CouponCategory {
  id         String @id @default(cuid())
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
}

model CouponUsage {
  id       String  @id @default(cuid())
  couponId String
  userId   String
  orderId  String?

  discountAmount Decimal @db.Decimal(18, 2)

  usedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
}

// ============================================================
// RETURNS
// ============================================================

model ReturnRequest {
  id      String @id @default(cuid())
  orderId String
  userId  String

  status ReturnStatus @default(REQUESTED)
  reason ReturnReason

  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  items ReturnItem[]

  refund Refund?

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model ReturnItem {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String

  quantity Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
}

model Refund {
  id              String @id @default(cuid())
  returnRequestId String @unique

  amount Decimal @db.Decimal(18, 2)

  status RefundStatus @default(PENDING)

  transactionId String?

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
}

// ============================================================
// MESSAGING
// ============================================================

model Conversation {
  id       String             @id @default(cuid())
  sellerId String?
  subject  String?
  status   ConversationStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  participants ConversationParticipant[]
  messages     Message[]

  @@index([sellerId])
  @@index([status])
}

model ConversationParticipant {
  id             String @id @default(cuid())
  conversationId String
  userId         String

  role UserRole

  joinedAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderId       String

  content String @db.Text

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id     String @id @default(cuid())
  userId String

  type    NotificationType
  channel NotificationChannel @default(IN_APP)

  title   String
  message String @db.Text

  data Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================================
// CMS
// ============================================================

model CmsPage {
  id String @id @default(cuid())

  seoId String? @unique

  title   String
  slug    String  @unique
  content String? @db.Text

  status CmsPageStatus @default(DRAFT)

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seo SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)

  @@index([status])
}

// ============================================================
// SELLER SEO
// ============================================================

model SellerSeo {
  id       String @id @default(cuid())
  sellerId String @unique
  seoId    String @unique

  seller Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  seo    SeoMetadata @relation(fields: [seoId], references: [id], onDelete: Cascade)
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  action AuditAction

  entityType String
  entityId   String

  oldData Json?
  newData Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
